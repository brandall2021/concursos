# Base de datos PostgreSQL
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST:5432/concursos_docentes

# NextAuth (v5)
AUTH_URL=http://localhost:3000
AUTH_SECRET=generá-con-openssl-rand-base64-32

# Google OAuth (una de las dos variantes de nombre)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email del primer administrador (whitelist en el login con Google)
ADMIN_EMAIL=

# Raíces de dominio Google permitidas para iniciar sesión, separadas por coma.
# Casa por sufijo: unt.edu.ar habilita face.unt.edu.ar.
# Vacío = sin restricción (sólo aplica la whitelist de la tabla User).
# Recomendado en producción: unt.edu.ar,edu.ar
AUTH_ALLOWED_DOMAINS=

# Control de tasa del formulario de inscripción (por IP, en memoria del proceso)
RATE_LIMIT_MAX=5
RATE_LIMIT_VENTANA_MIN=60

# Directorio de almacenamiento de los PDFs subidos
# (en producción montar un volumen persistente, p. ej. /app/uploads)
UPLOAD_DIR=./uploads

# Dirección que se imprime en el QR del comprobante.
# Es independiente de AUTH_URL (sesiones + enlace firmado): cambiar el dominio de
# login no tiene por qué cambiar la referencia que escanea un tercero.
PORTAL_URL=https://concursos.face-unt.ar

# Envío del comprobante por email (Gmail, opcional)
# Sin SMTP_USER + SMTP_PASSWORD + SMTP_FROM la inscripción funciona igual y no se envía el correo.
# Gmail no acepta la contraseña de la cuenta: activá la verificación en 2 pasos y generá una
# "contraseña de aplicación" en https://myaccount.google.com/apppasswords
# SMTP_FROM tiene que ser la misma cuenta autenticada (el nombre para mostrar es opcional).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=concursos.face@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=Concursos Docentes <concursos.face@gmail.com>
